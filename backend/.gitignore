# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Virtualenv — rebuild from requirements.txt, never commit
venv/
.venv/
env/

# Django
*.log
db.sqlite3
db.sqlite3-journal

# collectstatic output — regenerated at build time
staticfiles/

# Uploaded files. Production keeps these in Supabase Storage; the local copy is
# scratch data and, unlike the rest of the repo, it is real student documents.
#
# 'media/*', not 'media/'. Git will not descend into an excluded *directory*, so
# a later '!media/logos/' could never take effect — the negations below read as
# though they worked while every new branding file was silently unstageable, and
# a background added that way reached Render as a 404. Excluding the children
# instead leaves the directory itself visible, which is what lets a negation in.
media/*

# ...except the university's own branding. Templates reference these by fixed
# /media/ paths and they are part of the application rather than anything a user
# uploaded, so they ship with the code. Page backgrounds used to live here too;
# they are static/img/backgrounds/ now, where assets of this kind belong.
!media/logos/

# Secrets — only .env.example belongs in git
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch files that accumulated at the repo root
tmp.txt
tmp_lines.txt
result.txt
q-dev-chat-*.html

# Tailwind toolchain. The generated static/css/tailwind.css IS committed, so
# Render never needs Node at build time.
node_modules/

# Coverage's raw data files. The generated REPORTS under docs/quality are
# committed on purpose — they are the evidence a reviewer opens — but the
# binary .coverage database they are built from is machine-local and changes
# on every run.
.coverage
.coverage.*
htmlcov/
.report_cache/

# Scratch output from the split tooling
.split_plan.json

# The generated coverage HTML and its JSON. Both are rebuilt by
# tools/quality_report.py in one command, and together they are 7 MB that git
# would store again in full on every regeneration. The text reports beside
# them — SUMMARY.md, coverage/report.txt, complexity.txt — are committed,
# because those are what a reviewer reads.
docs/quality/coverage/html/
docs/quality/coverage/coverage.json
