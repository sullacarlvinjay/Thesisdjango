# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Virtualenv — rebuild from requirements.txt, never commit
venv/
.venv/
env/

# Django
*.log
db.sqlite3
db.sqlite3-journal

# collectstatic output — regenerated at build time
staticfiles/

# Uploaded files. Production keeps these in Supabase Storage; the local copy is
# scratch data and, unlike the rest of the repo, it is real student documents.
#
# 'media/*', not 'media/'. Git will not descend into an excluded *directory*, so
# a later '!media/logos/' could never take effect — the negations below read as
# though they worked while every new branding file was silently unstageable, and
# a background added that way reached Render as a 404. Excluding the children
# instead leaves the directory itself visible, which is what lets a negation in.
media/*

# ...except the university's own branding. Templates reference these by fixed
# /media/ paths and they are part of the application rather than anything a user
# uploaded, so they ship with the code. Page backgrounds used to live here too;
# they are static/img/backgrounds/ now, where assets of this kind belong.
!media/logos/

# Secrets — only .env.example belongs in git
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch files that accumulated at the repo root
tmp.txt
tmp_lines.txt
result.txt
q-dev-chat-*.html
