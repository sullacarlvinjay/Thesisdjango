# Copy to .env for local development. On Render these are set in the dashboard
# under Environment instead, and .env is not deployed.
#
# Every value below is a production default unless marked otherwise. Anything
# left unset falls back to the safe choice, so the site fails to start rather
# than starting insecure.

# ── Core ─────────────────────────────────────────────────────────────────────

# True only on a laptop. Never on Render.
DEBUG=False

# Required whenever DEBUG is False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated. Render adds its own *.onrender.com hostname automatically,
# so this only needs your custom domain, if you have one.
ALLOWED_HOSTS=srms.bipsu.edu.ph

# Comma-separated, and these need the scheme. Render adds its own too.
CSRF_TRUSTED_ORIGINS=https://srms.bipsu.edu.ph

TIME_ZONE=Asia/Manila
LOG_LEVEL=INFO

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase dashboard -> Project Settings -> Database -> Connection string.
#
# Use the CONNECTION POOLER host. The "direct connection" host,
# db.<ref>.supabase.co, has an IPv6 address and no IPv4 one, and Render's free
# tier cannot route IPv6 -- it fails at connect time in a way that looks like a
# password problem but is not.
#
# On the pooler, prefer SESSION mode (port 5432) over transaction mode (6543):
# session mode keeps normal Postgres session semantics, which is what Django's
# conn_max_age and psycopg3's prepared statements both expect.
#
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Leave unset to keep using local SQLite.

DATABASE_URL=

# If the password contains # / or ? the URL cannot be parsed, and percent-
# encoding it is easy to get wrong. These are an alternative to DATABASE_URL
# with no quoting rules at all; set either form, not both. DATABASE_URL wins.
#
# PGHOST=aws-0-<region>.pooler.supabase.com
# PGPORT=5432
# PGUSER=postgres.<ref>
# PGPASSWORD=
# PGDATABASE=postgres


# ── Uploaded files (Supabase Storage) ────────────────────────────────────────
# Render's free tier has no persistent disk — anything written to the container
# is lost on the next deploy. Turn this on in production so student documents
# survive. Credentials: Supabase dashboard → Project Settings → Storage → S3.
#
# Create the bucket as PRIVATE. Files are served through api.media_views, which
# checks the requester first; a public bucket would bypass that entirely.

USE_SUPABASE_STORAGE=False
SUPABASE_S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# Must match the project's own region, shown on the Supabase dashboard and on
# the S3 connection page. A wrong region is accepted at startup and only fails
# when someone uploads, so copy it rather than assuming.
SUPABASE_S3_REGION=ap-northeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=srms-media

# Largest single upload accepted, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# ── Office accounts ──────────────────────────────────────────────────────────
# `manage.py bootstrap` runs during the deploy and creates these two accounts,
# because Render's free plan has no shell to run createsuperuser in. The SDSO
# account is the superuser and also reaches /admin/.
#
# An office whose password is unset here is skipped rather than created with a
# guessable one, and an account that already exists is never modified -- so a
# password changed later in the admin survives the next deploy.

SDSO_EMAIL=sdso@bipsu.edu.ph
SDSO_PASSWORD=
UNIFAST_EMAIL=unifast@bipsu.edu.ph
UNIFAST_PASSWORD=

# ── HTTPS ────────────────────────────────────────────────────────────────────
# Applied only when DEBUG is False.

SECURE_SSL_REDIRECT=True

# Starts at one hour. Raise to 31536000 only once you are certain the domain
# will never serve plain http again — browsers cache this and it is hard to undo.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ── Email ───────────────────────────────────────────────────────────────────
# Two things depend on this, not one:
#
#   * applicants are told what the SDSO decided, by email as well as in the
#     portal — and a rejected applicant has no portal, so the email is the only
#     way they hear anything at all;
#   * a registrant is sent a link to confirm the address is theirs. Until they
#     open it nobody knows the address reaches anyone, and the SDSO's queue says
#     so on every unconfirmed account.
#
# Leave EMAIL_HOST blank and the messages print to the console instead of being
# sent — that is the right setting for a laptop and for the test suite. The
# office's screens say so out loud rather than reporting a delivery that never
# happened.
#
# For Gmail: turn on 2-Step Verification, then create an App Password
# (myaccount.google.com → Security → App passwords) and use that here, NOT the
# account's own password.

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Seconds to wait on the mail server before giving up. A slow server must not
# hold up the office's review screen.
EMAIL_TIMEOUT=10

# What recipients see in the From line. Optional: left unset it becomes
# 'BiPSU SRMS <EMAIL_HOST_USER>', derived from the account being logged into.
#
# Set it only when the address really is one that account may send as. A mail
# server will not honour a From it does not own — Gmail rewrites it to the
# authenticated account — so putting no-reply@bipsu.edu.ph here while signing in
# as Gmail does not do what it looks like: recipients see the Gmail address.
# An institutional mailbox, or an alias verified under Gmail's 'Send mail as',
# is what makes this worth setting.
# DEFAULT_FROM_EMAIL=BiPSU SRMS <no-reply@bipsu.edu.ph>

# Used to build the links inside those emails, and the only source that is
# right when a proxy rewrites the host. Without it a confirmation link is built
# from the request instead, which is usually correct but not behind a proxy —
# set it on anything public.
SITE_URL=https://srms.bipsu.edu.ph


# ── CORS ─────────────────────────────────────────────────────────────────────
# Only relevant if the separate Vite frontend is revived; the portal itself is
# server-rendered and does not need these.

CORS_ALLOWED_ORIGINS=
