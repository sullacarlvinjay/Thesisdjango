# Copy to .env for local development. On Render these are set in the dashboard
# under Environment instead, and .env is not deployed.
#
# Every value below is a production default unless marked otherwise. Anything
# left unset falls back to the safe choice, so the site fails to start rather
# than starting insecure.

# ── Core ─────────────────────────────────────────────────────────────────────

# True only on a laptop. Never on Render.
DEBUG=False

# Required whenever DEBUG is False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated. Render adds its own *.onrender.com hostname automatically,
# so this only needs your custom domain, if you have one.
ALLOWED_HOSTS=srms.bipsu.edu.ph

# Comma-separated, and these need the scheme. Render adds its own too.
CSRF_TRUSTED_ORIGINS=https://srms.bipsu.edu.ph

TIME_ZONE=Asia/Manila
LOG_LEVEL=INFO

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase dashboard -> Project Settings -> Database -> Connection string.
#
# Use the CONNECTION POOLER host. The "direct connection" host,
# db.<ref>.supabase.co, has an IPv6 address and no IPv4 one, and Render's free
# tier cannot route IPv6 -- it fails at connect time in a way that looks like a
# password problem but is not.
#
# On the pooler, prefer SESSION mode (port 5432) over transaction mode (6543):
# session mode keeps normal Postgres session semantics, which is what Django's
# conn_max_age and psycopg3's prepared statements both expect.
#
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Leave unset to keep using local SQLite.

DATABASE_URL=

# If the password contains # / or ? the URL cannot be parsed, and percent-
# encoding it is easy to get wrong. These are an alternative to DATABASE_URL
# with no quoting rules at all; set either form, not both. DATABASE_URL wins.
#
# PGHOST=aws-0-<region>.pooler.supabase.com
# PGPORT=5432
# PGUSER=postgres.<ref>
# PGPASSWORD=
# PGDATABASE=postgres


# ── Uploaded files (Supabase Storage) ────────────────────────────────────────
# Render's free tier has no persistent disk — anything written to the container
# is lost on the next deploy. Turn this on in production so student documents
# survive. Credentials: Supabase dashboard → Project Settings → Storage → S3.
#
# Create the bucket as PRIVATE. Files are served through api.media_views, which
# checks the requester first; a public bucket would bypass that entirely.

USE_SUPABASE_STORAGE=False
SUPABASE_S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# Must match the project's own region, shown on the Supabase dashboard and on
# the S3 connection page. A wrong region is accepted at startup and only fails
# when someone uploads, so copy it rather than assuming.
SUPABASE_S3_REGION=ap-northeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=srms-media

# Largest single upload accepted, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# ── Office accounts ──────────────────────────────────────────────────────────
# `manage.py bootstrap` runs during the deploy and creates this account,
# because Render's free plan has no shell to run createsuperuser in. The SDSO
# account is the superuser and also reaches /admin/.
#
# An office whose password is unset here is skipped rather than created with a
# guessable one, and an account that already exists is never modified -- so a
# password changed later in the admin survives the next deploy.

SDSO_EMAIL=sdso@bipsu.edu.ph
SDSO_PASSWORD=

# ── HTTPS ────────────────────────────────────────────────────────────────────
# Applied only when DEBUG is False.

SECURE_SSL_REDIRECT=True

# One year, which is the figure that means anything. An hour -- where this
# started -- is too short to be a protection: a browser that has not visited
# since lunchtime is back to trusting a plaintext first request.
#
# It is still worth understanding before raising it further: browsers cache
# this and it cannot be withdrawn early. Set it low again only while moving
# the domain, and never turn PRELOAD on unless the domain will never serve
# plain http again -- removal from the preload list takes months.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Report-only sends Content-Security-Policy-Report-Only instead of the
# enforcing header, so a policy change can be watched before it breaks a page.
# The policy itself is in config/settings.py, not here: it names hosts, and a
# host list belongs with the code that knows which ones the pages load from.
CSP_REPORT_ONLY=False

# -- Two-step sign-in ---------------------------------------------------------
# Office accounts read Listahanan status, disability and household income. A
# second factor is available on every account and enforced on the roles named
# here once MFA_ENFORCED is on.
#
# Enforcement is off by default so that turning it on is a decision somebody
# makes rather than something a deploy does to them. Turned on, an office
# account that has not enrolled is sent to its own profile page to enrol; it
# is not locked out, because locking the office out of its own records is not
# a privacy improvement. Enrol first, then set this.
MFA_ENFORCED=False
MFA_REQUIRED_ROLES=vpsea

# ── Email ───────────────────────────────────────────────────────────────────
# Two things depend on this, not one:
#
#   * applicants are told what the SDSO decided, by email as well as in the
#     portal — and a rejected applicant has no portal, so the email is the only
#     way they hear anything at all;
#   * a registrant is sent a link to confirm the address is theirs. Until they
#     open it nobody knows the address reaches anyone, and the SDSO's queue says
#     so on every unconfirmed account.
#
# Two routes out. BREVO_API_KEY sends over Brevo's HTTPS API; EMAIL_HOST sends
# over SMTP. Set one. Brevo wins if both are set.
#
# Which one depends on where this is running, and the reason is not a
# preference. Render's free plan blocks outbound traffic to ports 25, 465 and
# 587, so on Render a perfectly correct SMTP configuration connects to nothing:
# every send waits out EMAIL_TIMEOUT and is swallowed, and the site looks like
# it is emailing people while nobody receives anything. Use Brevo there. Use
# SMTP on a laptop, on a paid instance, or wherever the university runs this
# with a mail server of its own.
#
# Brevo rather than one of the others for one reason: it verifies a single
# sender ADDRESS by emailing it a link, where most verify a whole DOMAIN by DNS
# record, and nobody here can add records to bipsu.edu.ph. Free tier is 300
# messages a day.
#
#   1. Sign up, then Senders, domains & dedicated IPs > add and verify the
#      address you will send from.
#   2. SMTP & API > API keys > create one, and put it in BREVO_API_KEY.
#   3. Set EMAIL_HOST_USER to that same verified address. Brevo refuses any
#      other sender, and DEFAULT_FROM_EMAIL is derived from it.

BREVO_API_KEY=

# Leave EMAIL_HOST blank and the messages print to the console instead of being
# sent — that is the right setting for a laptop and for the test suite. The
# office's screens say so out loud rather than reporting a delivery that never
# happened.
#
# For Gmail: turn on 2-Step Verification, then create an App Password
# (myaccount.google.com → Security → App passwords) and use that here, NOT the
# account's own password.

# The sender address, and the account SMTP signs in as. Needed on both routes:
# on SMTP it is the login, on Brevo it is the verified sender.
EMAIL_HOST_USER=

# The SMTP route. Leave EMAIL_HOST blank when using Brevo — setting both
# invites the belief that this one is doing something.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Seconds to wait on whichever route is in use — the SMTP conversation, or
# the HTTPS call to Brevo. Slow mail must not hold up the office's review
# screen.
EMAIL_TIMEOUT=10

# What recipients see in the From line. Optional: left unset it becomes
# 'BiPSU SRMS <EMAIL_HOST_USER>', derived from the account being logged into.
#
# Set it only when the address really is one that account may send as. A mail
# server will not honour a From it does not own — Gmail rewrites it to the
# authenticated account — so putting no-reply@bipsu.edu.ph here while signing in
# as Gmail does not do what it looks like: recipients see the Gmail address.
# An institutional mailbox, or an alias verified under Gmail's 'Send mail as',
# is what makes this worth setting.
# DEFAULT_FROM_EMAIL=BiPSU SRMS <no-reply@bipsu.edu.ph>

# Used to build the links inside those emails, and the only source that is
# right when a proxy rewrites the host. Without it a confirmation link is built
# from the request instead, which is usually correct but not behind a proxy —
# set it on anything public.
SITE_URL=https://srms.bipsu.edu.ph


# ── Support address ──────────────────────────────────────────────────────────
# The address behind the "Need help?" button that floats on the landing page and
# on the student and staff portals. Leave it blank and the button points at the
# landing page's FAQ instead of opening a mail client — which is the honest
# behaviour, because a mailto: to an address nobody reads is worse than no
# button. Set it to the mailbox the SDSO actually watches.
SUPPORT_EMAIL=

# ── Caching ──────────────────────────────────────────────────────────────────
# Two pages do real work: the landing catalogue reads every active programme,
# and analytics opens a rollover workbook per programme per semester — which in
# production is a round trip to S3 each time, on every filter change.
#
# Both are cached under a key that includes a version of the data itself (row
# counts and the newest timestamp), so an approval, an import or an edit shows
# up on the next request without anyone clearing anything. The numbers below are
# only the ceiling on how stale a figure can get when nothing has changed; the
# analytics page prints when its figures were worked out and offers a
# "Recalculate now" link that ignores the cache entirely.
#
# Leave REDIS_URL blank and each web process keeps its own in-memory cache. That
# is fine here — the cache holds derived numbers, never a session or anything
# that has to agree between processes. Set it if a Redis instance is available
# and you would rather the processes shared one.
REDIS_URL=

CATALOGUE_CACHE_SECONDS=300
ANALYTICS_CACHE_SECONDS=600

# ── CORS ─────────────────────────────────────────────────────────────────────
# Only relevant if the separate Vite frontend is revived; the portal itself is
# server-rendered and does not need these.

CORS_ALLOWED_ORIGINS=
